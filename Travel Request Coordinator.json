    {
      "parameters": {
        "promptType": "define",
        "text": "=Prepare a travel itinerary draft for this client request.\n\nClient: {{ $('Check Details').item.json[\"Client Email\"] }}\nDestination: {{ $('Check Details').item.json[\"Destination\"] }}\nDeparting from: {{ $('Check Details').item.json[\"Departing From\"] }}\nDeparture date: {{ $('Check Details').item.json[\"Departure Date\"] }}\nReturn date: {{ $('Check Details').item.json[\"Return Date\"] }}\nPreferred departure time: {{ $('Check Details').item.json[\"Preferred Departure Time\"] }}\nTravelers: {{ $('Check Details').item.json[\"Number of Travelers\"] }}\nPreferences: {{ $('Check Details').item.json[\"Travel Preferences\"] }}\n\nResearch notes (flights, hotels, destination):\n{{ $json.output }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are a professional travel coordinator. Write a clear, friendly itinerary email body in simple HTML (p, ul, li, b only; no html/body tags). Include: a greeting, trip summary (route, dates, travelers), flight options, hotel options matching the preferences, destination tips, a day-by-day outline, and a short note that final bookings and prices are pending confirmation. Base flights, hotels and destination facts on the research notes only. Show prices only if the notes give them, labelled indicative. Do not invent prices, flight numbers or booking references. Output only the HTML."
            }
          ]
        },
        "batching": {}
      },
