        0
      ],
      "credentials": {
        "httpTemplatedCustomAuth": {
          "id": "0Iw6qG8rGlqzNrwI",
          "name": "Fireflies API Key (Dikeledi K)"
        }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "data.transcript.participants",
        "options": {
          "destinationFieldName": "attendeeEmail"
        }
      },
      "id": "859a1c36-a351-4bf4-b991-3e1509fd3adc",
      "name": "One Item Per Attendee",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.attendeeEmail.trim().toLowerCase() }}",
              "rightValue": "={{ ($('Get Meeting Summary').item.json.data.transcript.organizer_email || '').toLowerCase() }}",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            },
            {
              "leftValue": "={{ $json.attendeeEmail }}",
              "rightValue": "@",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "26f55735-1c94-439e-a77d-b4aa1783a34f",
      "name": "Skip Organizer",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "email": "={{ $json.attendeeEmail.trim() }}",
        "additionalFields": {
          "membershipNote": "={{ 'Meeting: ' + ($('Get Meeting Summary').item.json.data.transcript.title || '') + '\\n\\nOverview:\\n' + ($('Get Meeting Summary').item.json.data.transcript.summary.overview || '') + '\\n\\nAction items:\\n' + ($('Get Meeting Summary').item.json.data.transcript.summary.action_items || '') }}"
        },
        "options": {
          "resolveData": false
        }
      },
      "id": "f4a74e92-ef5f-4a21-bece-d1e0281c0282",
