        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: \"query Transcript($id: String!) { transcript(id: $id) { id title organizer_email participants summary { overview action_items } } }\", variables: { id: $json.body.meeting_id } }) }}",
        "options": {}
      },
      "id": "2b5b6d8f-0224-4e48-8b49-d597a5034c5b",
      "name": "Get Meeting Summary",
      "type": "n8n-nodes-base.httpRequest",
