            {
              "id": "name",
              "name": "Name",
              "type": "string",
              "value": "={{ ($json.From || \"\").includes(\"<\") ? $json.From.split(\"<\")[0].replace(/\"/g, \"\").trim() : \"\" }}"
            },
            {
              "id": "email",
              "name": "Email",
              "type": "string",
              "value": "={{ ($json.From || \"\").includes(\"<\") ? $json.From.split(\"<\")[1].replace(\">\", \"\").trim() : ($json.From || \"\").trim() }}"
            },
            {
              "id": "subject",
              "name": "Subject",
              "type": "string",
              "value": "={{ $json.Subject }}"
            },
            {
              "id": "message",
              "name": "Message",
              "type": "string",
              "value": "={{ $json.snippet }}"
            },
            {
              "id": "received",
              "name": "Received At",
              "type": "string",
              "value": "={{ DateTime.fromMillis(Number($json.internalDate)).setZone(\"Africa/Johannesburg\").toFormat(\"yyyy-MM-dd HH:mm\") }}"
            },
            {
              "id": "msgid",
              "name": "Email ID",
              "type": "string",
              "value": "={{ $json.id }}"
            }
          ]
        },
        "options": {}
      },
