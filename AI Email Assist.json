        "text": "={Classify this email.}\n\nFrom: {{ $json.From }}\nSubject: {{ $json.Subject }}\nMessage: {{ $json.snippet }}}",
        "messages": {
          "messageValues": [
            {
              "message": "You are an email assistant for Dikeledi, who runs a VA and automation business.\n\nClassify each email into exactly one category:\n- Urgent: needs action today (deadlines, complaints, payment problems)\n- Lead: a new person or business asking about services or a meeting\n- Client: an existing client's request or update\n- Admin: invoices, receipts, notifications, scheduling\n- Other: newsletters, promotions, anything unclear\n\nReturn only valid JSON in this format:\n{\"category\": \"\", \"summary\": \"one short sentence\", \"needs_reply\": true or false}"
            }
          ]
        },
        "batching": {}
